# Server
PORT=8080

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sparklink

# Redis (optional - leave empty to disable)
REDIS_HOST=
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-random-string
JWT_EXPIRE=168h

# SMS API (optional - leave empty to use dev console log)
SMS_ENDPOINT=https://api.sms-provider.com/send
SMS_API_KEY=
SMS_APP_SECRET=

# Admin
ADMIN_KEY=change-this-in-production

# Mock mode (set to "true" to run without database)
USE_MOCK=false
